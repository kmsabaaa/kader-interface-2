generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum ListingVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum TransactionStatus {
  REQUESTED
  ACCEPTED
  ESCROW_FUNDED
  HANDOVER_CONFIRMED
  RETURNED_BY_CONSUMER
  CONDITION_VERIFIED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ListingType {
  EQUIPMENT
  LOCATION
}

model User {
  id           String    @id @default(cuid())
  clerkId      String    @unique 
  role         String    @default("CONSUMER") 
  name         String?
  email        String?
  
  // Wallet & Financials
  walletBalance Float    @default(0.00)
  
  // Creator Profile
  isCreator    Boolean   @default(false)
  creatorTitle String?   
  creatorBio   String?   @db.Text
  showreelUrl  String?   
  location     String?   
  instagram    String?
  linkedin     String?
  profileImage String?

  // Relationships
  projects     Project[]
  listings     Listing[] 
  services     Service[] 
  reviews      Review[]    @relation("UserReviews")
  givenReviews Review[]    @relation("AuthoredReviews")
  
  // Transactions as either buyer or seller
  purchases    Transaction[] @relation("Buyer")
  sales        Transaction[] @relation("Seller")
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clerkId])
}

model Project {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      String          @default("PLANNING") 
  budget      Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources   CallSheetItem[] 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

model Listing {
  id              String           @id @default(cuid())
  title           String    
  description     String?   @db.Text
  type            ListingType      @default(EQUIPMENT) 
  visibility      ListingVisibility @default(PUBLISHED)
  availability    AvailabilityStatus @default(AVAILABLE)
  pricePerDay     Float            @default(0.00) 
  imageUrl        String?   
  
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        CallSheetItem[] 
  reviews         Review[]
  
  locationProfile LocationProfile? 

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

model Transaction {
  id            String            @id @default(cuid())
  amount        Float
  fee           Float             // Kader Platform Fee
  status        TransactionStatus @default(REQUESTED)
  
  buyerId       String
  buyer         User              @relation("Buyer", fields: [buyerId], references: [id])
  
  sellerId      String
  seller        User              @relation("Seller", fields: [sellerId], references: [id])
  
  callSheetItemId String          @unique
  callSheetItem   CallSheetItem   @relation(fields: [callSheetItemId], references: [id])

  isDisputed    Boolean           @default(false)
  disputeReason String?           @db.Text

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([buyerId])
  @@index([sellerId])
}

model CallSheetItem {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  listingId String?   
  listing   Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  serviceId String?   
  service   Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  status    TransactionStatus @default(REQUESTED) 
  startDate DateTime? 
  endDate   DateTime? 
  totalCost Float             @default(0.00)
  
  transaction Transaction?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([projectId])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      @default(5)
  comment     String?  @db.Text
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  targetUserId String?
  targetUser   User?   @relation("UserReviews", fields: [targetUserId], references: [id])
  authorId     String
  author       User    @relation("AuthoredReviews", fields: [authorId], references: [id])
  createdAt    DateTime @default(now())

  @@index([listingId])
}

model LocationProfile {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  address            String?
  typeOfLocation     String?  
  sqftArea           String?  
  sunDirection       String?  
  powerSupply        String?  
  soundConditions    String?  
  lightingConditions String?  
  permitStatus       String?  
  restrictions       String?  @db.Text 
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Service {
  id          String          @id @default(cuid())
  title       String          
  description String?
  pricePerDay Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    CallSheetItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}
