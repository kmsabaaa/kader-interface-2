generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum ListingVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum TransactionStatus {
  REQUESTED
  ESCROW_FUNDED
  HANDOVER_CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  clerkId      String    @unique 
  role         String    @default("CONSUMER") 
  name         String?
  isCreator    Boolean   @default(false)
  creatorTitle String?   
  creatorBio   String?   @db.Text
  showreelUrl  String?   

  projects     Project[]
  listings     Listing[] 
  services     Service[] 
  reviews      Review[]    @relation("UserReviews") // Reviews this user received
  givenReviews Review[]    @relation("AuthoredReviews") // Reviews this user wrote
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([clerkId])
}

model Project {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      String          @default("PLANNING") 
  budget      Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources   CallSheetItem[] 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Listing {
  id              String           @id @default(cuid())
  title           String    
  description     String?   @db.Text
  type            String           @default("EQUIPMENT") 
  visibility      ListingVisibility @default(PUBLISHED)
  availability    AvailabilityStatus @default(AVAILABLE)
  pricePerDay     Float            @default(0.00) 
  imageUrl        String?   
  
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        CallSheetItem[] 
  reviews         Review[]
  
  locationProfile LocationProfile? 

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([type])
  @@index([visibility])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      @default(5)
  comment     String?  @db.Text
  
  // Review can be for a listing (Gear/Location) or a User (Talent/Provider)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  
  targetUserId String?
  targetUser   User?   @relation("UserReviews", fields: [targetUserId], references: [id])
  
  authorId     String
  author       User    @relation("AuthoredReviews", fields: [authorId], references: [id])

  createdAt    DateTime @default(now())

  @@index([listingId])
  @@index([targetUserId])
  @@index([authorId])
}

model CallSheetItem {
  id        String            @id @default(cuid())
  projectId String
  listingId String?   
  serviceId String?   
  status    TransactionStatus @default(REQUESTED) 
  startDate DateTime? 
  endDate   DateTime? 
  totalCost Float             @default(0.00)
  
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@index([listingId])
  @@index([serviceId])
  @@index([status])
}

model LocationProfile {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  address            String?
  typeOfLocation     String?  
  sqftArea           String?  
  sunDirection       String?  
  powerSupply        String?  
  soundConditions    String?  
  lightingConditions String?  
  parkingLink        String?  
  permitStatus       String?  
  restrictions       String?  @db.Text 
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Service {
  id          String          @id @default(cuid())
  title       String          
  description String?
  pricePerDay Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    CallSheetItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}
