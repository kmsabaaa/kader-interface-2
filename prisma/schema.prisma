generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum ListingVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

model User {
  id           String    @id @default(cuid())
  clerkId      String    @unique 
  role         String    @default("CONSUMER") 
  isCreator    Boolean   @default(false)
  creatorTitle String?   
  creatorBio   String?   @db.Text
  showreelUrl  String?   

  projects     Project[]
  listings     Listing[] 
  services     Service[] 
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([clerkId])
}

model Project {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      String          @default("PLANNING") 
  budget      Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources   CallSheetItem[] 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Listing {
  id              String           @id @default(cuid())
  title           String    
  description     String?   @db.Text
  type            String           @default("EQUIPMENT") 
  
  // Visibility: Controls if the public can even SEE the listing
  visibility      ListingVisibility @default(PUBLISHED)
  
  // Availability: Controls the booking state (replaces the old boolean)
  availability    AvailabilityStatus @default(AVAILABLE)
  
  pricePerDay     Float            @default(0.00) 
  imageUrl        String?   
  
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        CallSheetItem[] 
  
  locationProfile LocationProfile? 

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([type])
  @@index([visibility])
  @@index([availability])
}

model LocationProfile {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  address            String?
  typeOfLocation     String?  
  sqftArea           String?  
  sunDirection       String?  
  
  powerSupply        String?  
  soundConditions    String?  
  lightingConditions String?  
  parkingLink        String?  
  
  permitStatus       String?  
  restrictions       String?  @db.Text 

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Service {
  id          String          @id @default(cuid())
  title       String          
  description String?
  pricePerDay Float           @default(0.00)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    CallSheetItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

model CallSheetItem {
  id        String    @id @default(cuid())
  projectId String
  listingId String?   
  serviceId String?   
  status    String    @default("PENDING") 
  startDate DateTime? 
  endDate   DateTime? 
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@index([listingId])
  @@index([serviceId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}
